{
  "name": "reado-local-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:legacy": "node scripts/build-app.mjs",
    "start:legacy": "node scripts/serve.mjs",
    "dev:legacy": "node scripts/build-app.mjs && node scripts/serve.mjs",
    "build:dynamic": "npm --prefix reado-v2 install --cache $HOME/.npm && npm --prefix reado-v2 run build",
    "start:dynamic": "npm --prefix reado-v2 run start",
    "dev:dynamic": "npm --prefix reado-v2 install --cache $HOME/.npm && npm --prefix reado-v2 run dev",
    "localize:images": "node scripts/localize-remote-images.mjs",
    "build": "npm run build:dynamic",
    "start": "npm run start:dynamic",
    "dev": "npm run dev:dynamic",
    "stitch-bridge": "node scripts/studio-tools/stitch-bridge.mjs",
    "pdf-mcp-bridge": "node scripts/studio-tools/pdf-mcp-bridge.mjs",
    "backfill:builtin-knowledge": "node scripts/backfill-builtin-knowledge.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  }
}
